# Claus AI: set each tier independently in Site server settings.
AI_FAST_PROVIDER=
AI_FAST_MODEL=
AI_REASONING_PROVIDER=
AI_REASONING_MODEL=
# Optional explicit failover for provider outages.
AI_FAST_FALLBACK_PROVIDER=
AI_FAST_FALLBACK_MODEL=
AI_REASONING_FALLBACK_PROVIDER=
AI_REASONING_FALLBACK_MODEL=
CRM_OWNER_EMAIL=your-sign-in-email
MS_MAILBOX=your-microsoft-mailbox
BRAD_CELL=your-cell-number
TELNYX_BUSINESS_NUMBER=your-telnyx-number
# Semantic search uses D1 and the same server-side OpenAI key as reasoning.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
# AI costs are conservatively estimated until exact model prices are configured.
AI_MONTHLY_TARGET_USD=25
AI_MONTHLY_WARNING_USD=50
AI_MONTHLY_HARD_LIMIT_USD=75
AI_DAILY_HARD_LIMIT_USD=5
AI_MAX_REQUEST_COST_USD=0.25
AI_TEST_MODE=false
AI_TEST_MONTHLY_LIMIT_USD=10
AUTO_GENERATE_MESSAGE_DRAFTS=false
# Optional rates per 1M tokens, calibrated to the chosen models.
AI_FAST_INPUT_USD_PER_MILLION=
AI_FAST_OUTPUT_USD_PER_MILLION=
AI_REASONING_INPUT_USD_PER_MILLION=
AI_REASONING_OUTPUT_USD_PER_MILLION=
AI_EMBEDDING_INPUT_USD_PER_MILLION=
